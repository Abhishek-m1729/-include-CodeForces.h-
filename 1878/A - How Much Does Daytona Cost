#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int tc;
    cin >> tc;
    while(tc--)
    {
        int n, k;
        cin >> n >> k;
        
        bool found = false;
        vector<int> vec(n);
        for(int i=0; i<n; ++i){
            cin >> vec[i];
            if(vec[i] == k){
                found = true;
            } 
        } 
        
        if(!found) cout << "NO" << endl;
        else cout << "YES" << endl;
    }
 
    return 0;
}