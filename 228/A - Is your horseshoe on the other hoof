#include <bits/stdc++.h>
#define endl '
'
using namespace std;
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    vector<long long> shoes(4);
    for(auto &ele : shoes) cin >> ele;
    
    sort(shoes.begin(), shoes.end());
    
    int cont = 0;
    for(int i=1; i<4; ++i){
        if(shoes[i] == shoes[i-1]) cont ++;
    }
    
    cout << cont << endl;
    
    return 0;
}