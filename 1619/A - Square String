#include <bits/stdc++.h>
using namespace std;
 
void Is_Square_Str(string str)
{
    int sz = str.size();
	if(sz % 2 != 0) cout << "NO" << '
';
	else
	{
	   int fe = 0, me = sz / 2;
	   bool found = true;
	   while(fe < sz/2){
	       if(str[fe] != str[me]){
	           cout << "NO" << '
';
	           found = false;
	           break;
	       }
	       fe ++;
	       me ++;
	   }
	   if(found) cout << "YES" << '
';
	}
}
 
int main()
{
	int t;
	cin >> t;
	while(t --)
	{
	    string str;
	    cin >> str;
	    
	    Is_Square_Str(str);
	}
	
    return 0;
}